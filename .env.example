# =============================================================================
# Environment Configuration — Spark + Spark Streaming + Kafka + Airflow Only
# =============================================================================

# Host Ports
KAFKA_PORT=9092
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8082
SPARK_WORKER_UI_PORT=8083
SPARK_STREAMING_UI_PORT=4040
AIRFLOW_UI_PORT=8088

# Resource Limits (Tuned for Docker Desktop / WSL2)
KAFKA_HEAP_OPTS=-Xmx320m -Xms192m
SPARK_WORKER_MEMORY=512m
SPARK_WORKER_CORES=2

# Optional: Auto-run a script placed in ./spark/streaming on container start
# Example: STREAMING_JOB=my_stream_job.py
STREAMING_JOB=

# Airflow Web UI Credentials
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=spark-kafka-airflow-dev-secret
