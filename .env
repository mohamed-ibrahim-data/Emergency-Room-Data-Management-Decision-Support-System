# =====================================================================
# Emergency Room Data Engineering — Environment Variables
# =====================================================================

# === Ports ===
KAFKA_PORT=9092
SPARK_MASTER_UI_PORT=8082
SPARK_MASTER_PORT=7077
SPARK_WORKER_UI_PORT=8083
SPARK_WORKER_2_UI_PORT=8084
SPARK_STREAMING_UI_PORT=4040
AIRFLOW_UI_PORT=8088
POSTGRES_PORT=5432
GRAFANA_PORT=3000
JUPYTER_PORT=8888
JUPYTER_SPARK_UI_PORT=4041
KAFKA_UI_PORT=8090

# === Jupyter ===
JUPYTER_TOKEN=

# === PostgreSQL (Data Warehouse — Gold Layer) ===
POSTGRES_USER=er_admin
POSTGRES_PASSWORD=er_password
POSTGRES_DB=er_data_warehouse

# === Airflow ===
AIRFLOW_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=spark-kafka-airflow-dev-secret
AIRFLOW_JWT_SECRET=spark-kafka-airflow-jwt-secret

# === Grafana ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# === Spark Resources ===
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2
KAFKA_HEAP_OPTS=-Xmx320m -Xms192m

# === Spark Streaming ===
STREAMING_JOB=
