# =============================================================================
# Dockerfile.spark — Apache Spark 3.5.3 + Spark Streaming + Isolated /opt/venv
# =============================================================================
FROM apache/spark:3.5.3-python3

USER root

# 1. Install python3-venv & curl for isolated virtual environment and healthchecks
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-venv curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 2. Pre-install Spark 3.5.3 Structured Streaming & DStreams Kafka 0-10 JARs
ARG MAVEN_BASE=https://repo1.maven.org/maven2
RUN curl -fsSL "${MAVEN_BASE}/org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.3/spark-sql-kafka-0-10_2.12-3.5.3.jar" \
      -o /opt/spark/jars/spark-sql-kafka-0-10_2.12-3.5.3.jar \
    && curl -fsSL "${MAVEN_BASE}/org/apache/spark/spark-streaming-kafka-0-10_2.12/3.5.3/spark-streaming-kafka-0-10_2.12-3.5.3.jar" \
      -o /opt/spark/jars/spark-streaming-kafka-0-10_2.12-3.5.3.jar \
    && curl -fsSL "${MAVEN_BASE}/org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.5.3/spark-token-provider-kafka-0-10_2.12-3.5.3.jar" \
      -o /opt/spark/jars/spark-token-provider-kafka-0-10_2.12-3.5.3.jar \
    && curl -fsSL "${MAVEN_BASE}/org/apache/kafka/kafka-clients/3.4.1/kafka-clients-3.4.1.jar" \
      -o /opt/spark/jars/kafka-clients-3.4.1.jar \
    && curl -fsSL "${MAVEN_BASE}/org/apache/commons/commons-pool2/2.11.1/commons-pool2-2.11.1.jar" \
      -o /opt/spark/jars/commons-pool2-2.11.1.jar

# 2b. PostgreSQL JDBC driver for Star Schema (Gold Layer) writes
RUN curl -fsSL "https://jdbc.postgresql.org/download/postgresql-42.7.4.jar" \
      -o /opt/spark/jars/postgresql-42.7.4.jar

# 3. Create isolated Python virtual environment (/opt/venv) and link built-in PySpark
COPY requirements.spark.txt /tmp/requirements.spark.txt
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.spark.txt \
    && SITE_PKGS=$(/opt/venv/bin/python -c "import site; print(site.getsitepackages()[0])") \
    && ls -d /opt/spark/python /opt/spark/python/lib/py4j-*-src.zip > "${SITE_PKGS}/pyspark_builtin.pth" \
    && rm -f /tmp/requirements.spark.txt

# 4. Prepare clean workspace mount directories
RUN mkdir -p /opt/spark-jobs /opt/spark-streaming /opt/data /tmp/spark-checkpoints \
    && chown -R spark:spark /opt/venv /opt/spark/jars /opt/spark-jobs /opt/spark-streaming /opt/data /tmp/spark-checkpoints

# Activate /opt/venv for all Spark drivers, workers, and shells
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:/opt/spark/bin:/opt/spark/sbin:${PATH}"
ENV PYSPARK_PYTHON=/opt/venv/bin/python
ENV PYSPARK_DRIVER_PYTHON=/opt/venv/bin/python

WORKDIR /opt/spark
USER spark
